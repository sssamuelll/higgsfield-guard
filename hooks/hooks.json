{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*|Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/higgsfield-guard.js\" hook --agent claude",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/higgsfield-guard.js\" sync",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
